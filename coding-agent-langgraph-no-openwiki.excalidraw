   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Audit: approvals(thread_id, interrupt_id, gate, decision, reason, created_at)\nCancel: reject/abort all pending, mark CANCELLED, stop the run cleanly.",
   "originalText": "Audit: approvals(thread_id, interrupt_id, gate, decision, reason, created_at)\nCancel: reject/abort all pending, mark CANCELLED, stop the run cleanly.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
  },
  {
   "id": "e507",
   "type": "text",
   "x": 1800,
   "y": 6144,
   "width": 900,
   "height": 25,
