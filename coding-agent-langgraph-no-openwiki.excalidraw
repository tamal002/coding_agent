   "updated": 1,
   "link": null,
   "locked": false,
   "text": "messages        add_messages reducer\nthread_id / run_id / workspace_path / iteration\ntask            {text, type, success_criteria, risk}\nplan            {steps[{id, goal, agent, deps, status}], version}\nready_steps     step ids chosen by N5, fanned out with Send\nstep_results    dict, merge reducer (parallel-safe join in N7)\ncontext_refs    pointers to Serena symbols / files, not raw text\nartifact_refs   pointers into S3 (logs, diffs, test output)\nerror           {kind, step_id, message}\n                kind: transient | context | plan | agent | fatal | verify\nattempts        dict[step_id → retry count]\nbudget          {tokens, cost, elapsed, iterations, max_*}\nhuman           {pending_interrupt_ids[], decisions{}, feedback, last_gate}\n                cache only: S1 state.interrupts is authoritative\nstatus          running | waiting_human | done | partial | aborted",
   "originalText": "messages        add_messages reducer\nthread_id / run_id / workspace_path / iteration\ntask            {text, type, success_criteria, risk}\nplan            {steps[{id, goal, agent, deps, status}], version}\nready_steps     step ids chosen by N5, fanned out with Send\nstep_results    dict, merge reducer (parallel-safe join in N7)\ncontext_refs    pointers to Serena symbols / files, not raw text\nartifact_refs   pointers into S3 (logs, diffs, test output)\nerror           {kind, step_id, message}\n                kind: transient | context | plan | agent | fatal | verify\nattempts        dict[step_id → retry count]\nbudget          {tokens, cost, elapsed, iterations, max_*}\nhuman           {pending_interrupt_ids[], decisions{}, feedback, last_gate}\n                cache only: S1 state.interrupts is authoritative\nstatus          running | waiting_human | done | partial | aborted",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
