  {
   "id": "e511",
   "type": "text",
   "x": 2760,
   "y": 6144,
   "width": 1040,
   "height": 25,
   "angle": 0,
   "strokeColor": "#0b4f8a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
