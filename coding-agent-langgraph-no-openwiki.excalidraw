   "link": null,
   "locked": false,
   "text": "ApprovalRequest\nrequest_id        UI / audit only\ninterrupt_id      resume key (Interrupt.id)\ngate / kind       H1..H4 / clarify|plan|tool|blocker\nstep_id / subagent\ntool / args_preview / artifact_id\nstatus            PENDING|RESOLVING|RESOLVED|REJECTED|CANCELLED|FAILED",
   "originalText": "ApprovalRequest\nrequest_id        UI / audit only\ninterrupt_id      resume key (Interrupt.id)\ngate / kind       H1..H4 / clarify|plan|tool|blocker\nstep_id / subagent\ntool / args_preview / artifact_id\nstatus            PENDING|RESOLVING|RESOLVED|REJECTED|CANCELLED|FAILED",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
